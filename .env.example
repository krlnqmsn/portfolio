[TEMPLATE]
# Contact form delivery via EmailJS (free): https://www.emailjs.com
# Dashboard → Account → Public key  → NEXT_PUBLIC_PUBLIC_ID
# Dashboard → Email Services         → NEXT_PUBLIC_SERVICE_ID
# Dashboard → Email Templates        → NEXT_PUBLIC_TEMPLATE_ID
# Put these in .env.local (and in your host's env settings). Without them the
# form falls back to opening the visitor's mail app with the message pre-filled.
NEXT_PUBLIC_PUBLIC_ID=
NEXT_PUBLIC_SERVICE_ID=
NEXT_PUBLIC_TEMPLATE_ID=
